{
  "name": "huit-contestflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "prisma generate && next build",
    "start": "next start",
    "test:e2e": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/e2e-check.ps1",
    "db:backup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db-backup.ps1",
    "db:restore": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db-restore.ps1",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed-admin": "node --env-file=.env scripts/seed-admin.mjs",
    "db:seed-judge": "node --env-file=.env scripts/seed-judge.mjs",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "next": "16.4.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "mariadb": "^3.5.4",
    "prisma": "7.10.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.0"
  }
}
